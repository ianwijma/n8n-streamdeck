{
  "name": "@n8n-streamdeck/backend",
  "version": "1.0.0",
  "description": "Backend service for N8N StreamDeck integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "jest",
    "test:streamdeck": "tsx src/scripts/testStreamDeck.ts",
    "test:streamdeck:mock": "tsx src/scripts/testStreamDeck.ts --mock",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.3.2",
    "@n8n-streamdeck/config": "workspace:*",
    "@n8n-streamdeck/shared": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0"
  }
}