{
  "name": "@n8n-streamdeck/backend",
  "version": "1.0.0",
  "description": "Backend service for N8N StreamDeck integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "PORT=3001 CHOKIDAR_USEPOLLING=true tsx watch --ignore node_modules --ignore dist --ignore coverage --ignore .next --ignore build --ignore tmp --ignore temp --ignore .cache --ignore test-results --ignore e2e --ignore load-testing --ignore docs --ignore scripts --ignore .git src/index.ts",
    "start": "node dist/index.js",
    "start:test": "NODE_ENV=test node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:streamdeck": "tsx src/scripts/testStreamDeck.ts",
    "test:streamdeck:mock": "tsx src/scripts/testStreamDeck.ts --mock",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "migration:create": "tsx src/scripts/createMigration.ts create",
    "migration:deploy": "tsx src/scripts/createMigration.ts deploy",
    "migration:status": "tsx src/scripts/createMigration.ts status",
    "migration:reset": "tsx src/scripts/createMigration.ts reset",
    "migration:generate": "tsx src/scripts/createMigration.ts generate"
  },
  "dependencies": {
    "@elgato-stream-deck/node": "^7.3.2",
    "@n8n-streamdeck/config": "workspace:*",
    "@n8n-streamdeck/shared": "workspace:*",
    "@prisma/client": "^6.12.0",
    "@types/socket.io": "^3.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.12.0",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^7.1.3",
    "ts-jest": "^29.1.2",
    "tsx": "^4.7.0"
  }
}
