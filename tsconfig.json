{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "types": ["node"],
    "paths": {
      "@n8n-streamdeck/shared": ["./packages/shared/src"],
      "@n8n-streamdeck/shared/*": ["./packages/shared/src/*"],
      "@n8n-streamdeck/config": ["./packages/config/src"],
      "@n8n-streamdeck/config/*": ["./packages/config/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".next"]
}
